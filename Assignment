));
}
}


cout << "\n========== CROP REPORT ==========\n";       
for (const auto& crop : crops) {             
crop->display();             
const Advisory* advice =                 dynamic_cast<const Advisory*>(crop.get());             
if (advice != nullptr)                 
advice->giveAdvice();         
}
double totalYield = 0;         
for (const auto& crop : crops)             totalYield += crop->calculateYield();
cout << "\nTotal Farm Yield: " << totalYield << " quintals\n";         
cout << "Total Crops Recorded: " << Crop::getCropCount() << "\n";

if (crops.size() >= 2) {             
cout << "\n========== CROP COMPARISON ==========\n";             if (*crops[0] > *crops[1]) {                 
cout << crops[0]->getName()                      
     << " has a higher yield than "
