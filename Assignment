class Advisory { 
public:
virtual void giveAdvice() const = 0;     virtual ~Advisory() {} 
};
class Crop { protected:
string name, season;     double area, yieldPerAcre;     static int cropCount;
public:     
Crop(): name("Unknown"), area(1), season("Summer"),      yieldPerAcre(1) {       
  cropCount++;     
}
Crop(string n, double a, string s, double y): name(n), area(a), season(s), yieldPerAcre(y) {         
if (a <= 0 || y <= 0)            
throw invalid_argument(                 
"Area and yield must be positive!"      
 );         
cropCount++;     
}
virtual ~Crop() {         cropCount--;    
 }
virtual double calculateYield() const {         return area * yieldPerAcre;    
 }
virtual void display() const {         
cout << "\nCrop Name  : " << name              << "\nArea (acres)    : " << area
<< "\nSeason          : " << season
<< "\nYield/Acre      : " << yieldPerAcre
<< "\nTotal Yield     : "
<< calculateYield() << " quintals\n";
    }
bool operator>(const Crop& other) const {         
return calculateYield() > other.calculateYield();    
 }
virtual void saveToFile(ofstream& file) const {         file << "Crop Name: " << name             
     << " | Type  : General Crop"
     << " | Area  : " << area
     << " acres | Season: " << season
     << " | Yield/Acre  : " << yieldPerAcre                      << " | Total Yield      : " << calculateYield()              << " quintals\n";   
  }
    static int getCropCount() {         return cropCount;
 }
string getName() const {         return name; 
} 
};
int Crop::cropCount = 0;

class CerealCrop : public Crop, public Advisory { private:
string fertilizerType;
public:
CerealCrop() : Crop(), fertilizerType("Urea") {}
CerealCrop(string n, double a, string s, double y, string f): Crop(n, a, s, y), fertilizerType(f) {}
    void display() const override {         
cout << "\n--- Cereal Crop Details ---";         Crop::display();        
 cout << "Fertilizer Type  : " << fertilizerType << "\n";
}
    void giveAdvice() const override {         
cout << "Farming Advice: Use balanced fertilizer, "                           << "control weeds, and monitor soil moisture.\n"; 
}
void saveToFile(ofstream& file) const override {         file << "Crop Name: " << name              
     << " | Type: Cereal"
     << " | Area: " << area
     << " acres | Season: " << season
     << " | Yield/Acre  : " << yieldPerAcre
     << " | Fertilizer  : " << fertilizerType
     << " | Total Yield : " << calculateYield()
     << " quintals\n";
    }
};
class VegetableCrop : public Crop, public Advisory { private:
int irrigationFrequency;
public:     
VegetableCrop() : Crop(), irrigationFrequency(3) {}
VegetableCrop(string n, double a, string s, double y, int irrigation)     : Crop(n, a, s, y), irrigationFrequency(irrigation) {         
if (irrigation <= 0)             
throw invalid_argument(                 
"Irrigation frequency must be positive!"
 );     
}
    void display() const override {         
cout << "\n--- Vegetable Crop Details ---";         Crop::display();         
cout << "Irrigation : " << irrigationFrequency                 << " times per week\n"; 
}
    void giveAdvice() const override {         
cout << "Farming Advice: Maintain proper irrigation, "                 << "check for pests, and use well-drained soil.\n";     
}
void saveToFile(ofstream& file) const override {         file << "Crop Name: " << name             
     << " | Type: Vegetable"
     << " | Area: " << area
     << " acres | Season: " << season
     << " | Yield/Acre: " << yieldPerAcre
     << " | Irrigation: " << irrigationFrequency
     << " times/week | Total Yield: "                 << calculateYield() << " quintals\n";
    }
};
double readPositiveDouble(const string& message) {     double value;    
 while (true) {         
cout << message;         
if (cin >> value && value > 0)             
return value;
cout << "Invalid input! Enter a positive number.\n";      cin.clear();
cin.ignore(numeric_limits<streamsize>::max(), '\n');
} 
}
int main() {     vector<unique_ptr<Crop>> crops;     int n;
cout << fixed << setprecision(2);     
cout << "====================================\n";    cout << "   SMART FARM MANAGEMENT SYSTEM\n";    
 cout << "====================================\n";
